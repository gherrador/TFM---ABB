# -----------------------------------------------------------------------------
# Configuración de infraestructura local del TFM
# Copiar a .env únicamente cuando sea necesario sobrescribir los valores por defecto.
# -----------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=tfm_tightening
POSTGRES_USER=tfm_user
POSTGRES_PASSWORD=tfm_password
POSTGRES_HOST_PORT=5433

# Confluent Platform / Kafka
CONFLUENT_PLATFORM_VERSION=8.3.1
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_HOST_PORT=9092
KAFKA_JMX_HOST_PORT=9101
KAFKA_RAW_TOPIC=torque-events-raw
KAFKA_RAW_TOPIC_PARTITIONS=3
SCHEMA_REGISTRY_HOST_PORT=8081
CONTROL_CENTER_HOST_PORT=9021

# Configuración del productor Kafka.
# El productor ejecutado desde el host local se conectará mediante localhost:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Simulador streaming
EXISTING_TU_OOS_PROBABILITY=0.025
NEW_TU_EVENT_PROBABILITY=0.03
NEW_TU_OOS_PROBABILITY=0.01
STREAM_EVENT_INTERVAL_SECONDS=0.5

# Spark streaming
SPARK_KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SPARK_STARTING_OFFSETS=earliest
SPARK_TRIGGER_SECONDS=5

# Control Center / observabilidad
CONTROL_CENTER_VERSION=2.6.0
PROMETHEUS_HOST_PORT=9090
ALERTMANAGER_HOST_PORT=9093
